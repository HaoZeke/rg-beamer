%% One TikZ canvas, same architecture as Execushares.
%% Cover = steel field. Content = steel title bar + copper lip + foot progress.
\mode<presentation>

\RequirePackage{tikz}

\makeatletter
\newdimen\rg@barht
\rg@barht=11.6mm
\newdimen\rg@lip
\rg@lip=2.3pt
\newdimen\rg@progressht
\rg@progressht=2.5mm
\newdimen\rg@progresswd
\newdimen\rg@split

\def\rg@setprogress{%
  \rg@progresswd=\paperwidth
  \ifdefstring{\rg@progress}{false}{}{%
    \ifnum\inserttotalframenumber>0
      \multiply\rg@progresswd by \insertframenumber
      \divide\rg@progresswd by \inserttotalframenumber
    \fi
  }%
}

\def\rg@fonttitle{%
  \ifdefined\rgdisplay\rgdisplay\fi
  \bfseries\fontsize{18}{22}\selectfont
}
\def\rg@fontcover{%
  \ifdefined\rgdisplay\rgdisplay\fi
  \bfseries\fontsize{26}{30}\selectfont
}

\defbeamertemplate*{background}{rg}{%
  \rg@setprogress
  \rg@split=0.40\paperheight
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
    \ifbool{rg@standout}{%
      \fill[rgsteel] (0,0) rectangle (\the\paperwidth,\the\paperheight);
    }{%
      \ifnum\insertframenumber=1
        \fill[rgpaper] (0,0) rectangle (\the\paperwidth,\the\paperheight);
        \fill[rgsteel] (0,\rg@split) rectangle (\the\paperwidth,\the\paperheight);
        \fill[rgcopper] (0,\rg@split) rectangle (\the\paperwidth,\rg@split+\rg@lip);
        \node[anchor=south west, text=rgpaper, inner sep=0,
              text width=\the\paperwidth-16mm, align=left]
          at (8mm, \rg@split+7mm)
          {\rg@fontcover\inserttitle};
        \node[anchor=north west, text=rgmute, inner sep=0,
              text width=\the\paperwidth-16mm, align=left,
              font=\normalsize]
          at (8mm, \rg@split-5mm)
          {\insertsubtitle};
        \node[anchor=south west, text=rgink, inner sep=0, font=\large]
          at (8mm, 11mm) {\insertauthor};
        \node[anchor=south west, text=rgmute, inner sep=0, font=\footnotesize]
          at (8mm, 6mm) {\insertdate};
      \else
        \fill[rgpaper] (0,0) rectangle (\the\paperwidth,\the\paperheight);
        \fill[rgsteel]
          (0, \the\paperheight-\rg@barht)
          rectangle (\the\paperwidth, \the\paperheight);
        \fill[rgcopper]
          (0, \the\paperheight-\rg@barht-\rg@lip)
          rectangle (\the\paperwidth, \the\paperheight-\rg@barht);
        \node[anchor=west, text=rgpaper, inner sep=0]
          at (8mm, \the\paperheight-0.52\rg@barht)
          {\rg@fonttitle\insertframetitle};
        \fill[rgtrack] (0,0) rectangle (\the\paperwidth, \rg@progressht);
        \fill[rgcopper] (0,0) rectangle (\rg@progresswd, \rg@progressht);
        \node[anchor=south west, text=rgmute, inner sep=0, font=\tiny]
          at (8mm, \rg@progressht+1.4mm) {\insertinstitute};
        \node[anchor=south east, text=rgmute, inner sep=0, font=\tiny]
          at (\the\paperwidth-6mm, \rg@progressht+1.4mm)
          {\insertframenumber\,/\,\inserttotalframenumber};
      \fi
    }%
  \end{tikzpicture}%
}

%% Space for the painted bar. Title itself is in the canvas.
\defbeamertemplate*{headline}{rg}{%
  \ifbool{rg@standout}{}{%
    \ifnum\insertframenumber=1
    \else
      \vspace*{12.2mm}%
    \fi
  }%
}
\defbeamertemplate*{frametitle}{rg}{}
\defbeamertemplate*{footline}{rg}{%
  \ifbool{rg@standout}{}{%
    \ifnum\insertframenumber=1
    \else
      \vspace*{5.4mm}%
    \fi
  }%
}
\setbeamertemplate{background canvas}{}
\makeatother

\mode<all>
