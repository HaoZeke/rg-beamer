%% beamerthemerg.sty -- HaoZeke / Rohit Goswami talk theme
%% Load with \usetheme{rg} after this directory is on TEXINPUTS.
\mode<presentation>

\RequirePackage{etoolbox}

\DeclareOptionBeamer{progress}{\def\rg@progress{true}}
\DeclareOptionBeamer{noprogress}{\def\rg@progress{false}}
\ExecuteOptionsBeamer{progress}
\ProcessOptionsBeamer

\makeatletter
\providebool{rg@standout}
\makeatother

\useinnertheme{rg}
\useoutertheme{rg}
\usecolortheme{rg}
\usefonttheme{rg}

%% Clear of the 5.6pt spine.
\setbeamersize{text margin left=13mm, text margin right=11mm}
\setbeamertemplate{navigation symbols}{}

%% Same option name as Metropolis so existing org snippets keep working.
\makeatletter
\define@key{beamerframe}{standout}[true]{%
  \rg@standouttrue
  \setkeys{beamerframe}{c,plain}%
  \setbeamercolor{normal text}{fg=rgpaper, bg=rgsteel}%
  \setbeamercolor{frametitle}{fg=rgpaper, bg=rgsteel}%
  \setbeamercolor{local structure}{fg=rgpaper}%
  \setbeamerfont{normal text}{size=\Large, series=\bfseries}%
  \usebeamercolor[fg]{normal text}%
  \centering
}
\pretocmd{\beamer@reseteecodes}{\rg@standoutfalse}{}{}
\makeatother

\mode<all>
