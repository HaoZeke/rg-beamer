%% Cool lab paper, steel ink, one copper mark. Not teal, not coral.
\mode<presentation>

\definecolor{rgpaper}{HTML}{F3F4F5}
\definecolor{rgink}{HTML}{1B1D1F}
\definecolor{rgsteel}{HTML}{243035}
\definecolor{rgcopper}{HTML}{C45C28}
\definecolor{rgmute}{HTML}{5E656A}
\definecolor{rgwell}{HTML}{D4D7DA}

\setbeamercolor{normal text}{fg=rgink, bg=rgpaper}
\setbeamercolor{structure}{fg=rgsteel}
\setbeamercolor{alerted text}{fg=rgcopper}
\setbeamercolor{example text}{fg=rgsteel}

\setbeamercolor{background canvas}{bg=rgpaper}
\setbeamercolor{frametitle}{fg=rgsteel, bg=rgpaper}
\setbeamercolor{framesubtitle}{fg=rgmute, bg=rgpaper}
\setbeamercolor{title}{fg=rgsteel, bg=rgpaper}
\setbeamercolor{subtitle}{fg=rgmute, bg=rgpaper}
\setbeamercolor{author}{fg=rgink, bg=rgpaper}
\setbeamercolor{date}{fg=rgmute, bg=rgpaper}
\setbeamercolor{institute}{fg=rgmute, bg=rgpaper}

\setbeamercolor{item}{fg=rgcopper}
\setbeamercolor{subitem}{fg=rgsteel}
\setbeamercolor{enumerate item}{fg=rgsteel}

\setbeamercolor{block title}{fg=rgsteel, bg=rgpaper}
\setbeamercolor{block body}{fg=rgink, bg=rgpaper}
\setbeamercolor{block title alerted}{fg=rgcopper, bg=rgpaper}
\setbeamercolor{block body alerted}{fg=rgink, bg=rgpaper}
\setbeamercolor{block title example}{fg=rgsteel, bg=rgpaper}
\setbeamercolor{block body example}{fg=rgink, bg=rgpaper}

\setbeamercolor{footline}{fg=rgmute, bg=}
\setbeamercolor{page number in head/foot}{fg=rgmute}

\setbeamercolor{section in toc}{fg=rgsteel}
\setbeamercolor{subsection in toc}{fg=rgink}

\setbeamercolor{bibliography item}{fg=rgsteel}
\setbeamercolor*{bibliography entry title}{fg=rgsteel}
\setbeamercolor*{bibliography entry author}{fg=rgink}
\setbeamercolor*{bibliography entry location}{fg=rgmute}
\setbeamercolor*{bibliography entry note}{fg=rgmute}

\setbeamercolor{caption}{fg=rgmute}
\setbeamercolor{caption name}{fg=rgsteel}

\mode<all>
