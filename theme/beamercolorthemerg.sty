%% Paper, teal ink, coral rule. Same three colours as the Kroes decks.
\mode<presentation>

\definecolor{rgpaper}{HTML}{F7F8F7}
\definecolor{rgink}{HTML}{1C2421}
\definecolor{rgteal}{HTML}{004D40}
\definecolor{rgcoral}{HTML}{FF655D}
\definecolor{rgmute}{HTML}{5A6660}

\setbeamercolor{normal text}{fg=rgink, bg=rgpaper}
\setbeamercolor{structure}{fg=rgteal}
\setbeamercolor{alerted text}{fg=rgcoral}
\setbeamercolor{example text}{fg=rgteal}

\setbeamercolor{background canvas}{bg=rgpaper}
\setbeamercolor{frametitle}{fg=rgteal, bg=rgpaper}
\setbeamercolor{title}{fg=rgteal, bg=rgpaper}
\setbeamercolor{subtitle}{fg=rgmute, bg=rgpaper}
\setbeamercolor{author}{fg=rgink, bg=rgpaper}
\setbeamercolor{date}{fg=rgmute, bg=rgpaper}
\setbeamercolor{institute}{fg=rgmute, bg=rgpaper}

\setbeamercolor{item}{fg=rgteal}
\setbeamercolor{subitem}{fg=rgcoral}
\setbeamercolor{enumerate item}{fg=rgteal}

\setbeamercolor{block title}{fg=rgteal, bg=rgpaper}
\setbeamercolor{block body}{fg=rgink, bg=rgpaper}
\setbeamercolor{block title alerted}{fg=rgcoral, bg=rgpaper}
\setbeamercolor{block body alerted}{fg=rgink, bg=rgpaper}
\setbeamercolor{block title example}{fg=rgteal, bg=rgpaper}
\setbeamercolor{block body example}{fg=rgink, bg=rgpaper}

\setbeamercolor{footline}{fg=rgmute, bg=rgpaper}
\setbeamercolor{page number in head/foot}{fg=rgmute}

\setbeamercolor{section in toc}{fg=rgteal}
\setbeamercolor{subsection in toc}{fg=rgink}

\setbeamercolor{bibliography item}{fg=rgteal}
\setbeamercolor*{bibliography entry title}{fg=rgteal}
\setbeamercolor*{bibliography entry author}{fg=rgink}
\setbeamercolor*{bibliography entry location}{fg=rgmute}
\setbeamercolor*{bibliography entry note}{fg=rgmute}

\setbeamercolor{caption}{fg=rgmute}
\setbeamercolor{caption name}{fg=rgteal}

\mode<all>
