%% rg-report.sty -- paper companion to beamerthemerg
%% White page, shortPdf title, eisvogel rules. No rail, no page colour.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rg-report}[2026/08/18 rg report]

\RequirePackage[margin=2.5cm,includehead=true,includefoot=true,centering]{geometry}
\RequirePackage{setspace}
\setstretch{1.18}
\RequirePackage[expansion=false]{microtype}
\RequirePackage{booktabs}
\RequirePackage[dvipsnames,svgnames,table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{fancyhdr}
\RequirePackage{parskip}
\RequirePackage{amsmath,amssymb}

\definecolor{rgink}{HTML}{1A1916}
\definecolor{rgsteel}{HTML}{1C2528}
\definecolor{rgcopper}{HTML}{C45C28}
\definecolor{rgmute}{HTML}{6B6560}

\color{rgink}

\@ifpackageloaded{fontspec}{%
  \IfFontExistsTF{Source Serif 4}{%
    \setmainfont{Source Serif 4}[Ligatures=TeX]%
  }{}%
  \IfFontExistsTF{Source Serif 4 Display}{%
    \newfontfamily\rgdisplay{Source Serif 4 Display}[%
      Ligatures=TeX,
      BoldFont={Source Serif 4 Display Semibold}]%
  }{%
    \newcommand{\rgdisplay}{\rmfamily}%
  }%
  \IfFontExistsTF{Source Sans 3}{%
    \setsansfont{Source Sans 3}[Ligatures=TeX]%
  }{}%
  \IfFontExistsTF{Source Code Pro}{%
    \setmonofont{Source Code Pro}[Scale=0.90]%
  }{}%
}{%
  \newcommand{\rgdisplay}{\rmfamily}%
}

\addtokomafont{section}{\rgdisplay\color{rgsteel}}
\addtokomafont{subsection}{\rgdisplay\color{rgsteel}}
\addtokomafont{subsubsection}{\rgdisplay\color{rgsteel}}
\addtokomafont{paragraph}{\color{rgsteel}\normalfont\bfseries}
\addtokomafont{title}{\rgdisplay\color{rgsteel}}
\addtokomafont{disposition}{\rgdisplay}

\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage[font={small,sf,it},labelfont={bf,sf,color=rgsteel}]{caption}
\renewcommand{\arraystretch}{1.22}

\newcommand{\HRule}{\textcolor{rgcopper}{\rule{\linewidth}{2pt}}}
\newcommand{\rg@series}{}
\newcommand{\rg@grant}{}
\newcommand{\rg@for}{}
\newcommand{\rgseries}[1]{\renewcommand{\rg@series}{#1}}
\newcommand{\rggrant}[1]{\renewcommand{\rg@grant}{#1}}
\newcommand{\rgfor}[1]{\renewcommand{\rg@for}{#1}}

% Cover: IPAM wgtex architecture (left bar, bottom bar, open field)
% in the steel/copper palette. Cover only; body stays white paper.
\makeatletter
\renewcommand{\@maketitle}{%
  \begin{titlepage}%
    \thispagestyle{empty}%
    \begin{tikzpicture}[remember picture, overlay]
      \fill[rgsteel]
        (current page.south west)
        rectangle ([xshift=11mm]current page.north west);
      \fill[rgcopper]
        ([xshift=11mm]current page.south west)
        rectangle ([xshift=11mm+2.3pt]current page.north west);
      \fill[rgcopper]
        (current page.south west)
        rectangle ([yshift=4.5mm]current page.south east);
    \end{tikzpicture}%
    \parindent=0pt
    \vspace*{2.4cm}%
    {\sffamily\small\color{rgcopper}%
      \ifdefempty{\rg@grant}{}{\rg@grant}%
      \ifdefempty{\rg@series}{}{%
        \ifdefempty{\rg@grant}{}{\,\textperiodcentered\,}%
        \rg@series}\par}%
    \vspace{1.5cm}%
    {\rgdisplay\fontsize{26}{31}\selectfont\bfseries\color{rgsteel}%
      \@title\par}%
    \ifdefined\@subtitle
      \ifx\@subtitle\@empty\else
        \vspace{0.55em}%
        {\sffamily\large\color{rgmute}\@subtitle\par}%
      \fi
    \fi
    \vspace{2.1cm}%
    {\rgdisplay\large\color{rgsteel}\@author\par}%
    \vspace{0.55em}%
    {\sffamily\small\color{rgmute}\@date\par}%
    \vfill
    \ifdefempty{\rg@for}{}{%
      {\sffamily\small\color{rgmute}For \rg@for\par}}%
    \vspace{1.35cm}%
  \end{titlepage}%
  \setcounter{page}{1}%
}
\makeatother

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rgsteel}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{rgsteel}\leaders\hrule height \footrulewidth\hfill}}
\fancyhead[L]{\small\sffamily\color{rgmute}\rgreporthead}
\fancyhead[R]{\small\sffamily\color{rgmute}\rgreportdate}
\fancyfoot[L]{\small\sffamily\color{rgmute}\rgreportfoot}
\fancyfoot[R]{\small\sffamily\color{rgmute}\thepage}

\newcommand{\rgreporthead}{}
\newcommand{\rgreportdate}{}
\newcommand{\rgreportfoot}{}
\newcommand{\rgreportmark}[3]{%
  \renewcommand{\rgreporthead}{#1}%
  \renewcommand{\rgreportdate}{#2}%
  \renewcommand{\rgreportfoot}{#3}%
}

\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=rgsteel,urlcolor=rgsteel,citecolor=rgsteel}
\renewcommand{\abstractname}{Abstract}

\endinput
