%% Title page is a cover, not a rule under a heading.
%% Blocks echo the spine: a copper rule, no fill.
\mode<presentation>

\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.2ex]\fill[rgcopper] (0,0) rectangle (0.34em,0.34em);%
}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.18ex]\fill[rgsteel] (0,0) rectangle (0.26em,0.26em);%
}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-0.15ex]\draw[rgcopper, line width=0.45pt] (0,0) rectangle (0.22em,0.22em);%
}
\setbeamertemplate{enumerate item}{%
  {\color{rgsteel}\bfseries\insertenumlabel.}%
}
\setbeamertemplate{enumerate subitem}{%
  {\color{rgcopper}\insertenumlabel)}%
}

\setbeamertemplate{caption}{\insertcaption}
\setbeamertemplate{caption label separator}{}

\defbeamertemplate*{title page}{rg}[1][]{%
  \vspace*{0.12\paperheight}%
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
  \vspace{0.85em}%
  {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
  \vfill
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
  \vspace{0.22em}%
  {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
  \vspace{0.08\paperheight}%
}

\setbeamertemplate{block begin}{%
  \par\vskip\medskipamount
  \noindent
  {\color{rgcopper}\vrule width 1.8pt}%
  \hspace{0.65em}%
  \begin{minipage}[t]{\dimexpr\textwidth-0.65em-1.8pt\relax}%
    {\usebeamerfont{block title}\usebeamercolor[fg]{block title}%
      \insertblocktitle\par}%
    \vskip0.45em
    \usebeamerfont{block body}%
    \usebeamercolor[fg]{block body}%
}
\setbeamertemplate{block end}{%
  \end{minipage}%
  \vskip\smallskipamount
}

\setbeamertemplate{block alerted begin}{%
  \par\vskip\medskipamount
  \noindent
  {\color{rgcopper}\vrule width 1.8pt}%
  \hspace{0.65em}%
  \begin{minipage}[t]{\dimexpr\textwidth-0.65em-1.8pt\relax}%
    {\usebeamerfont{block title}\usebeamercolor[fg]{block title alerted}%
      \insertblocktitle\par}%
    \vskip0.45em
    \usebeamerfont{block body}%
    \usebeamercolor[fg]{block body alerted}%
}
\setbeamertemplate{block alerted end}{%
  \end{minipage}%
  \vskip\smallskipamount
}

\setbeamertemplate{block example begin}{%
  \par\vskip\medskipamount
  \noindent
  {\color{rgsteel}\vrule width 1.8pt}%
  \hspace{0.65em}%
  \begin{minipage}[t]{\dimexpr\textwidth-0.65em-1.8pt\relax}%
    {\usebeamerfont{block title}\usebeamercolor[fg]{block title example}%
      \insertblocktitle\par}%
    \vskip0.45em
    \usebeamerfont{block body}%
    \usebeamercolor[fg]{block body example}%
}
\setbeamertemplate{block example end}{%
  \end{minipage}%
  \vskip\smallskipamount
}

\mode<all>
